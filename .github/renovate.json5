{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":dependencyDashboardApproval",
    "helpers:pinGitHubActionDigests"
  ],
  "minimumReleaseAge": "7 days",
  "postUpdateOptions": ["gomodTidy"],
  "customManagers": [
    {
      // Tool versions in workflows that no built-in manager picks up: a
      // `# renovate:` comment above a `key: value` line, and `npx pkg@x.y.z`.
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/[^/]+\\.ya?ml$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>[a-z-]+) depName=(?<depName>\\S+)\\s+[\\w-]+:\\s*(?<currentValue>\\S+)",
        "npx (?<depName>[\\w@./-]+)@(?<currentValue>\\d+\\.\\d+\\.\\d+)"
      ],
      "datasourceTemplate": "{{#if datasource}}{{{datasource}}}{{else}}npm{{/if}}"
    }
  ],
  "packageRules": [
    {
      "allowedVersions": "/^(24)\\./",
      "groupName": "Node.js",
      "matchPackageNames": ["node"]
    },
    {
      "allowedVersions": "/^(12)\\./",
      "matchPackageNames": ["pnpm"]
    },
    {
      // The Go toolchain in go.mod and the golang image move together.
      "groupName": "Go",
      "matchPackageNames": ["go", "golang"]
    }
  ]
}
